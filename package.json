{
  "name": "typing-tutor-remake",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 scripts/serve.py",
    "test": "node --test tests/*.test.mjs",
    "verify": "python3 scripts/verify-originals.py",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:prototype": "node tests/prototype-smoke.mjs",
    "resources": "python3 scripts/build-faithful-resources.py",
    "test:practice": "node tests/practice-browser.mjs",
    "test:adaptive": "node tests/adaptive-browser.mjs",
    "resources:curriculum": "python3 scripts/extract-curriculum-data.py",
    "test:reports": "node tests/tests-reports-browser.mjs",
    "resources:reports": "python3 scripts/extract-report-data.py",
    "test:keypad": "node tests/keypad-browser.mjs",
    "resources:keypad": "python3 scripts/extract-keypad-data.py",
    "test:disk": "node tests/disk-browser.mjs",
    "resources:disk": "python3 scripts/extract-disk-data.py",
    "test:invaders": "node tests/invaders-browser.mjs",
    "resources:invaders": "python3 scripts/extract-invaders-data.py",
    "package:web": "python3 scripts/package-web.py",
    "test:package": "node tests/package-browser.mjs",
    "test:audio": "node tests/game-audio-browser.mjs",
    "resources:welcome": "python3 scripts/extract-welcome-data.py",
    "test:welcome": "node tests/welcome-browser.mjs",
    "test:reset": "node tests/reset-browser.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  },
  "description": "A local browser reconstruction of Typing Tutor IV, with original keyboard lessons, reports and Letter Invaders.",
  "repository": {
    "type": "git",
    "url": "https://github.com/xichuanxc/typing-tutor-remake.git"
  },
  "homepage": "https://tt.xcstudio.dev",
  "bugs": {
    "url": "https://github.com/xichuanxc/typing-tutor-remake/issues"
  },
  "license": "MIT"
}
